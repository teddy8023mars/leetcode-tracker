# Runtime
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=mysql://user:password@localhost:3306/leetcode_tracker

# Auth / OAuth
JWT_SECRET=change-me-in-local-env
OWNER_OPEN_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# App
VITE_APP_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Scheduled sync
HEARTBEAT_SECRET=change-me-in-local-env

# LLM / Forge API
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Bootstrap options (set to 1 to skip)
BOOTSTRAP_SKIP_CN=
BOOTSTRAP_SKIP_LLM=

# One-off scripts
SKIP_COMPANIES=
